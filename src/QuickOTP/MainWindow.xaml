<Window x:Class="QuickOTP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickOTP"
        Width="920" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <DockPanel Margin="20">
    <Grid x:Name="HeaderBar" DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="QuickOTP" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource BrandFont}"/>
        <TextBlock Text="Codes OTP locaux — Gmail &amp; Outlook" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
      </StackPanel>
      <Button x:Name="PrivacyToggle" Grid.Column="1" Content="Privé · OFF" Style="{StaticResource GhostButton}"
              VerticalAlignment="Center" Click="PrivacyToggle_Click"/>
    </Grid>

    <TabControl x:Name="MainTabs">
      <!-- 0 Accueil -->
      <TabItem Header="Accueil">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
          <StackPanel x:Name="HomePanel">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="StatusText" Text="En veille" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="AccountsSummaryText" Text="Aucun compte connecté" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
                <TextBlock x:Name="LastServiceText" Text="En attente d'un e-mail…" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <TextBlock x:Name="LastCodeText" Text="········" FontSize="36" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <TextBlock x:Name="LastMetaText" Text="Ajoutez Gmail ou Outlook pour démarrer" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="PauseResumeButton" Content="Pause" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="PauseResumeButton_Click"/>
                  <Button Content="Mini" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OpenMini_Click"/>
                  <Button Content="Copier" Style="{StaticResource GhostButton}" Click="CopyLastCode_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="Sources" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="SourcesText" Text="Aucune source connectée." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 1 Historique -->
      <TabItem Header="Historique">
        <DockPanel Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Effacer" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ClearHistory_Click"/>
            <Button Content="Pas un code" Style="{StaticResource GhostButton}" Click="MarkFalsePositive_Click"/>
          </StackPanel>
          <Grid>
            <ListView x:Name="HistoryList">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Service" DisplayMemberBinding="{Binding Service}" Width="120"/>
                  <GridViewColumn Header="Code" DisplayMemberBinding="{Binding Code}" Width="120"/>
                  <GridViewColumn Header="Heure" DisplayMemberBinding="{Binding Time}" Width="80"/>
                  <GridViewColumn Header="Compte" DisplayMemberBinding="{Binding Account}" Width="160"/>
                  <GridViewColumn Header="Expire" DisplayMemberBinding="{Binding Expires}" Width="90"/>
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock x:Name="HistoryEmptyText" Text="Aucun code récent." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- 2 Comptes -->
      <TabItem Header="Comptes">
        <DockPanel Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Ajouter Gmail" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AddGmail_Click"/>
            <Button Content="Ajouter Outlook" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="AddMicrosoft_Click"/>
            <Button Content="Activer/Pause" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ToggleAccount_Click"/>
            <Button Content="Retirer" Style="{StaticResource GhostButton}" Click="RemoveAccount_Click"/>
          </StackPanel>
          <ListView x:Name="AccountsList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Provider" DisplayMemberBinding="{Binding Provider}" Width="100"/>
                <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="220"/>
                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/>
                <GridViewColumn Header="Enabled" DisplayMemberBinding="{Binding Enabled}" Width="80"/>
                <GridViewColumn Header="Erreur" DisplayMemberBinding="{Binding Error}" Width="220"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>

      <!-- 3 Règles -->
      <TabItem Header="Règles">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Domaines toujours acceptés (1 / ligne)" Margin="0,0,0,4"/>
            <TextBox x:Name="AlwaysDomainsBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="Rules_Save"/>
            <TextBlock Text="Domaines jamais détectés" Margin="0,12,0,4"/>
            <TextBox x:Name="NeverDomainsBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="Rules_Save"/>
            <TextBlock Text="Overrides service (domaine→Nom)" Margin="0,12,0,4"/>
            <TextBox x:Name="OverridesBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="Rules_Save"/>
            <TextBlock Text="Services sans auto-copie" Margin="0,12,0,4"/>
            <TextBox x:Name="NoAutoCopyBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="Rules_Save"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 4 Réglages -->
      <TabItem Header="Réglages">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
          <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <CheckBox x:Name="LaunchAtStartupCheck" Content="Lancer avec Windows" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="AutoCopyCheck" Content="Copier automatiquement les codes" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="NotificationsCheck" Content="Notifications" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="HotkeyCheck" Content="Raccourci global" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="HelloCheck" Content="Windows Hello pour l'historique" Checked="Settings_Changed" Unchecked="Settings_Changed"/>

            <TextBlock Text="Confidentialité notifs" Margin="0,14,0,4"/>
            <ComboBox x:Name="NotifPrivacyBox" SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="Normal"/>
              <ComboBoxItem Content="Privé"/>
              <ComboBoxItem Content="Silencieux"/>
            </ComboBox>

            <TextBlock Text="Effacer le presse-papiers" Margin="0,12,0,4"/>
            <ComboBox x:Name="ClipboardClearBox" SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="Jamais"/>
              <ComboBoxItem Content="30 s"/>
              <ComboBoxItem Content="1 min"/>
              <ComboBoxItem Content="2 min"/>
              <ComboBoxItem Content="5 min"/>
              <ComboBoxItem Content="10 min"/>
            </ComboBox>

            <TextBlock Text="Rétention historique" Margin="0,12,0,4"/>
            <ComboBox x:Name="HistoryRetentionBox" SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="Désactivé"/>
              <ComboBoxItem Content="15 min"/>
              <ComboBoxItem Content="1 h"/>
              <ComboBoxItem Content="24 h"/>
            </ComboBox>

            <TextBlock Text="Validité code (min)" Margin="0,12,0,4"/>
            <TextBox x:Name="ValidityBox" LostFocus="Settings_Changed"/>
            <TextBlock Text="Intervalle poll (s)" Margin="0,12,0,4"/>
            <TextBox x:Name="PollIntervalBox" LostFocus="Settings_Changed"/>
            <TextBlock Text="Raccourci" Margin="0,12,0,4"/>
            <TextBox x:Name="HotkeyBox" LostFocus="Settings_Changed"/>

            <TextBlock Text="Niveau de log" Margin="0,12,0,4"/>
            <ComboBox x:Name="LogLevelBox" SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="Off"/>
              <ComboBoxItem Content="Erreurs"/>
              <ComboBoxItem Content="Diagnostic"/>
            </ComboBox>

            <Button Content="Abonnement…" Style="{StaticResource GhostButton}" Margin="0,18,0,0" HorizontalAlignment="Left" Click="Subscription_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 5 Diagnostics -->
      <TabItem Header="Diagnostics">
        <DockPanel Margin="0,12,0,0">
          <Button DockPanel.Dock="Top" Content="Rafraîchir" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,12" Click="RefreshDiagnostics_Click"/>
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="Polling" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBlock x:Name="DiagPollingText" Text="—" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,16"/>
              <TextBlock Text="Latence" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBlock x:Name="DiagLatencyText" Text="—" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
